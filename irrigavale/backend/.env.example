# Copie para .env e ajuste. Nunca versione o .env real.
APP_ENV=development
DATABASE_URL=
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:8081"]
SCHEDULER_ENABLED=true
OFFLINE_AFTER_MINUTES=30
ALERT_COOLDOWN_HOURS=6
DEFAULT_TIMEZONE=America/Recife
# SMS: "log" (só registra no console, para testes) ou "twilio"
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Clima no painel via Open-Meteo (sem chave). Desligue se o servidor não tiver internet.
WEATHER_ENABLED=true
